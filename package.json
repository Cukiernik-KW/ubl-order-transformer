{
  "name": "ubl-order-transformer",
  "version": "0.1.0",
  "description": "Event-driven service that transforms Base64-encoded UBL 2.1 Order XML from Pub/Sub into a JSON order model.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "coverage": "vitest run --coverage",
    "samples": "tsx scripts/generate-samples.ts",
    "encode": "tsx scripts/encode-xml.ts",
    "simulate": "tsx scripts/simulate.ts",
    "publish:local": "tsx scripts/publish-local.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^6.3.2",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
